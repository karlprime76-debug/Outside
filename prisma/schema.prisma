generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum BudgetLevel {
  FREE
  LOW
  MEDIUM
  PREMIUM
}

enum Mood {
  CHILL
  FOOD
  SPORT
  PARTY
  MUSIC
  DATING
  FRIENDS
  STUDY
  BUSINESS
  CULTURE
  TRAVEL
  GAMING
  FITNESS
}

enum PlanVisibility {
  PUBLIC
  FRIENDS
  FRIENDS_OF_FRIENDS
  PRIVATE
  VERIFIED_ONLY
}

enum PlanStatus {
  ACTIVE
  FULL
  CANCELLED
  COMPLETED
}

enum PlaceCategory {
  RESTAURANT
  CAFE
  LOUNGE
  MAQUIS
  BEACH
  GYM
  CINEMA
  CULTURE
  SPORT
  EVENT
  SHOP
  OTHER
}

enum SafetyLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

enum ReportReason {
  INAPPROPRIATE_CONTENT
  HARASSMENT
  SPAM
  FAKE_PROFILE
  DANGEROUS_PLAN
  UNDERAGE
  OTHER
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id                String   @id @default(cuid())
  name              String?
  username          String?  @unique
  email             String   @unique
  password          String?
  emailVerified     DateTime?
  phone             String?  @unique
  phoneVerified     DateTime?
  image             String?
  bio               String?
  role              UserRole @default(USER)

  homeCityId        String?
  homeCity          City?    @relation("UserHomeCity", fields: [homeCityId], references: [id])
  activeCityId      String?
  activeCity        City?    @relation("UserActiveCity", fields: [activeCityId], references: [id])
  neighborhood      String?
  language          String   @default("fr")
  preferredBudget   BudgetLevel?
  preferredMoods    Mood[]

  isVerified        Boolean  @default(false)
  isAvailable       Boolean  @default(false)
  travelModeEnabled Boolean  @default(false)

  plansCreated      Plan[]
  planParticipants  PlanParticipant[]
  planMessages      PlanMessage[]
  reportsMade       Report[] @relation("Reporter")
  reportsReceived   Report[] @relation("Reported")
  blocksMade        UserBlock[] @relation("Blocker")
  blocksReceived    UserBlock[] @relation("Blocked")
  visitedCities     UserVisitedCity[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([homeCityId])
  @@index([activeCityId])
  @@index([isAvailable])
}

model City {
  id          String   @id @default(cuid())
  name        String
  country     String
  countryCode String
  currency    String
  timezone    String
  language    String   @default("fr")
  latitude    Float
  longitude   Float
  isActive    Boolean  @default(true)

  homeUsers   User[]   @relation("UserHomeCity")
  activeUsers User[]   @relation("UserActiveCity")
  places      Place[]
  plans       Plan[]
  visitedBy   UserVisitedCity[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, country])
}

model Place {
  id              String        @id @default(cuid())
  name            String
  description     String?
  category        PlaceCategory
  cityId          String
  city            City          @relation(fields: [cityId], references: [id])
  neighborhood    String?
  address         String?
  latitude        Float?
  longitude       Float?
  priceLevel      BudgetLevel?
  openingHours    String?
  images          String[]
  isPartner       Boolean       @default(false)
  isVisible       Boolean       @default(true)
  safetyLevel     SafetyLevel   @default(MEDIUM)
  popularityScore Int           @default(0)

  plans           Plan[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([cityId])
  @@index([category])
  @@index([isVisible])
}

model Plan {
  id                String          @id @default(cuid())
  title             String
  description       String?
  category          PlaceCategory
  mood              Mood
  budgetLevel       BudgetLevel
  estimatedCost     Float?
  cityId            String
  city              City            @relation(fields: [cityId], references: [id])
  placeId           String?
  place             Place?          @relation(fields: [placeId], references: [id])
  neighborhood      String?
  latitude          Float?
  longitude         Float?
  startDate         DateTime
  endDate           DateTime?
  maxParticipants   Int             @default(10)
  visibility        PlanVisibility  @default(PUBLIC)
  status            PlanStatus      @default(ACTIVE)
  isTravelerFriendly Boolean        @default(false)
  safetyLevel       SafetyLevel     @default(MEDIUM)
  rules             String?

  creatorId         String
  creator           User            @relation(fields: [creatorId], references: [id])
  participants      PlanParticipant[]
  messages          PlanMessage[]
  reports           Report[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([cityId])
  @@index([creatorId])
  @@index([status])
  @@index([visibility])
  @@index([mood])
  @@index([startDate])
}

model PlanParticipant {
  id        String            @id @default(cuid())
  planId    String
  plan      Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ParticipantStatus @default(PENDING)
  joinedAt  DateTime          @default(now())

  @@unique([planId, userId])
  @@index([planId])
  @@index([userId])
}

model PlanMessage {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([planId])
  @@index([createdAt])
}

model Report {
  id              String       @id @default(cuid())
  reporterId      String
  reporter        User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId  String?
  reportedUser    User?        @relation("Reported", fields: [reportedUserId], references: [id])
  planId          String?
  plan            Plan?        @relation(fields: [planId], references: [id])
  placeId         String?
  reason          ReportReason
  description     String?
  status          ReportStatus @default(PENDING)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([reporterId])
  @@index([status])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model UserVisitedCity {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId        String
  city          City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  firstVisitedAt DateTime @default(now())
  lastVisitedAt  DateTime @updatedAt

  @@unique([userId, cityId])
}
