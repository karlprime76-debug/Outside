generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  PRO
  ADMIN
  MODERATOR
}

enum AccountKind {
  STANDARD
  OFFICIAL_GUIDE
  OFFICIAL_CITY
  OFFICIAL_PARTNER
  VERIFIED_CREATOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  BLOCKED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FOLLOW
  PLAN_INVITE
  PLAN_REMINDER
  LIVE_STARTED
  PRO_EVENT
  PRO_APPROVED
  BADGE_EARNED
  SYSTEM
  DM_MESSAGE
  MOMENT_LIKE
  MOMENT_COMMENT
  DROP_AVAILABLE
  MISSION_AVAILABLE
  PLAN_GROUP_MESSAGE
  WEEKLY_RECAP_READY
  AMBASSADOR_TO_DISCOVER
  PLAN_REVIEW_PENDING
  PLAN_CONFIRMED
}

enum AvailabilityMood {
  FOOD
  CHILL
  SPORT
  MUSIC
  OUT
  STUDY
  BUSINESS
  TRAVEL
}

enum BudgetLevel {
  FREE
  LOW
  MEDIUM
  PREMIUM
}

enum Mood {
  CHILL
  FOOD
  SPORT
  PARTY
  MUSIC
  DATING
  FRIENDS
  STUDY
  BUSINESS
  CULTURE
  TRAVEL
  GAMING
  FITNESS
  DANCE
  WALK
  FREE
  MEET_PEOPLE
  CALM
  TONIGHT
  NOW
}

enum PlanVisibility {
  PUBLIC
  FRIENDS
  FRIENDS_OF_FRIENDS
  INVITE_ONLY
  PRIVATE
}

enum PlanStatus {
  ACTIVE
  FULL
  CANCELLED
  COMPLETED
}

enum OutsideStatusType {
  OUT_NOW
  AVAILABLE
  LOOKING_FOR_FOOD
  LOOKING_FOR_CHILL
  LOOKING_FOR_SPORT
  LOOKING_FOR_MUSIC
  DO_NOT_DISTURB
}

enum PlaceVibeSignalType {
  CALM
  CROWDED
  GOOD_MOOD
  EXPENSIVE
  FREE_ENTRY
  SAFE
  LOUD_MUSIC
  GOOD_FOOD
  BAD_MOOD
}

enum PlanInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum MomentType {
  PHOTO
  VIDEO
}

enum MomentVisibility {
  PUBLIC
  FRIENDS
  PLAN_PARTICIPANTS
  PRIVATE
}

enum ConversationType {
  DIRECT
  GROUP
  PLAN
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  DELETED
}

enum DirectMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  MOMENT
  PROFILE
  PLAN
  PLAN_INVITE
  SYSTEM
}

enum AccountKind {
  STANDARD
  OFFICIAL_GUIDE
  OFFICIAL_CITY
  VERIFIED_CREATOR
  PARTNER_VENUE
}

enum DirectMessagePermission {
  FRIENDS_ONLY
  FRIENDS_AND_FOLLOWING
  EVERYONE
}

enum AudioSourceType {
  OUTSIDE_LIBRARY
  USER_ORIGINAL
  ARTIST_UPLOAD
  MOMENT_ORIGINAL
}

enum AudioStatus {
  ACTIVE
  PENDING_REVIEW
  BLOCKED
  DELETED
}

enum MomentEventType {
  IMPRESSION
  VIEW
  COMPLETE_VIEW
  REPLAY
  LIKE
  UNLIKE
  COMMENT
  SHARE
  SHARE_DM
  SAVE
  PROFILE_OPEN
  FOLLOW_FROM_MOMENT
  NOT_INTERESTED
  SEE_MORE_LIKE_THIS
  REPORT
}

enum PlaceCategory {
  RESTAURANT
  CAFE
  LOUNGE
  MAQUIS
  BEACH
  GYM
  CINEMA
  CULTURE
  SPORT
  EVENT
  SHOP
  OTHER
}

enum PlanCategory {
  CHILL
  FOOD
  SPORT
  MUSIC
  SORTIE
  CULTURE
  BUSINESS
  VOYAGE
  ETUDES
  AUTRE
}

enum SafetyLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  PENDING
  OPEN
  REVIEWING
  REVIEWED
  RESOLVED
  REJECTED
  DISMISSED
}

enum ReportReason {
  INAPPROPRIATE_CONTENT
  HARASSMENT
  SPAM
  FAKE_PROFILE
  DANGEROUS_PLAN
  UNDERAGE
  SCAM
  VIOLENCE
  HATE
  SEXUAL_CONTENT
  PRIVATE_INFO
  COPYRIGHT
  OTHER
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PlanAttendanceStatus {
  GOING
  MAYBE
  LEFT
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  REPORTED
  BLOCKED
}

enum LiveVisibility {
  PUBLIC
  CITY
  PLAN_PARTICIPANTS
  EVENT_ATTENDEES
  PRIVATE
}

enum ProAccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProBusinessType {
  ORGANIZER
  VENUE
  BRAND
  RESTAURANT_BAR
  EVENT_AGENCY
  PROMOTER
  ARTIST_TEAM
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ENDED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum IdentityVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum VenueVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PlanReviewStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

enum TrustSignalType {
  PROFILE_PHOTO
  EMAIL_VERIFIED
  PHONE_VERIFIED
  IDENTITY_VERIFIED
  PLAN_ATTENDANCE
  RESPECTFUL
  REAL_PROFILE
  REAL_PLAN
}

model User {
  id                String   @id @default(cuid())
  name              String?
  username          String?  @unique
  email             String   @unique
  password          String?
  emailVerified     DateTime?
  phone             String?  @unique
  phoneVerified     DateTime?
  image             String?
  bio               String?
  gender            Gender?
  role              UserRole @default(USER)
  accountKind       AccountKind @default(STANDARD)
  isDemoAccount     Boolean  @default(false)

  birthDate         DateTime?
  isAdultConfirmed  Boolean  @default(false)
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?

  homeCityId        String?
  homeCity          City?    @relation("UserHomeCity", fields: [homeCityId], references: [id])
  activeCityId      String?
  activeCity        City?    @relation("UserActiveCity", fields: [activeCityId], references: [id])
  neighborhood      String?
  language          String   @default("fr")
  preferredBudget   BudgetLevel?
  preferredMoods    Mood[]

  country           String?
  countryCode       String?

  isVerified        Boolean  @default(false)
  referralCode      String?  @unique
  isAmbassador      Boolean  @default(false)
  ambassadorCity    String?
  trustScore        Int      @default(0)
  identityVerificationStatus IdentityVerificationStatus @default(NOT_SUBMITTED)
  isAvailable       Boolean  @default(false)
  travelModeEnabled Boolean  @default(false)

  plansCreated      Plan[]
  planParticipants  PlanParticipant[]
  planMessages      PlanMessage[]
  planInvitationsSent    PlanInvitation[] @relation("PlanInvitationSender")
  planInvitationsReceived PlanInvitation[] @relation("PlanInvitationReceiver")
  moments            Moment[]
  audioTracks        AudioTrack[]
  userBadges         UserBadge[]
  reportsMade       Report[] @relation("Reporter")
  reportsReceived   Report[] @relation("Reported")
  blocksMade        UserBlock[] @relation("Blocker")
  blocksReceived    UserBlock[] @relation("Blocked")
  visitedCities     UserVisitedCity[]
  friendshipsInitiated Friendship[] @relation("FriendshipInitiator")
  friendshipsReceived  Friendship[] @relation("FriendshipReceiver")

  friendRequestsSent     FriendRequest[] @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestReceiver")

  followers  Follow[] @relation("UserFollowers")
  following  Follow[] @relation("UserFollowing")

  notifications     Notification[] @relation("NotificationRecipient")
  trustReviewsGiven    TrustReview[] @relation("TrustReviewReviewer")
  trustReviewsReceived TrustReview[] @relation("TrustReviewReviewed")
  planReviewsGiven     PlanParticipantReview[] @relation("PlanReviewReviewer")
  planReviewsReceived  PlanParticipantReview[] @relation("PlanReviewReviewed")
  availabilities       Availability[]

  liveSessions      LiveSession[]
  proAccount        ProAccount?
  identityVerification IdentityVerification?
  trustSignals      TrustSignal[]
  userSettings      UserSettings?
  trustProfile      UserTrustProfile?
  pushSubscriptions PushSubscription[]
  momentLikes       MomentLike[]
  momentComments    MomentComment[]
  conversationParticipants ConversationParticipant[]
  directMessagesSent       DirectMessage[]
  directMessageReactions  DirectMessageReaction[]
  savedPlans        SavedPlan[]
  planReminders     PlanReminder[]
  proVenues         ProVenue[]
  safetyContacts    SafetyContact[] @relation("UserSafetyContacts")
  trustedByContacts SafetyContact[] @relation("TrustedByContacts")
  safetyShares      PlanSafetyShare[]
  outsideStatus     UserOutsideStatus?
  challengeProgress UserChallengeProgress[]
  missionProgress   UserCityMissionProgress[]
  onboardingProgress OnboardingProgress?
  referralInvites   ReferralInvite[] @relation("ReferralInviter")
  acceptedReferral  ReferralInvite?   @relation("ReferralAccepted")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([homeCityId])
  @@index([activeCityId])
  @@index([isAvailable])
  @@index([username])
  @@index([countryCode])
}

model UserSettings {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileVisibility        String  @default("PUBLIC")
  showCityOnProfile        Boolean @default(true)
  allowFriendRequests      Boolean @default(true)
  directMessagePermission  DirectMessagePermission @default(FRIENDS_ONLY)
  allowFollowers           Boolean @default(true)
  allowFriendSuggestions   Boolean @default(true)
  privateDiscoveryMode     Boolean @default(false)

  notificationFriendRequests Boolean @default(true)
  notificationPlanInvites    Boolean @default(true)
  notificationPlanReminders  Boolean @default(true)
  notificationLiveStarted    Boolean @default(true)
  notificationCityLives      Boolean @default(true)
  notificationProEvents      Boolean @default(true)
  notificationMoments        Boolean @default(true)

  pushEnabled                Boolean @default(false)
  pushDm                     Boolean @default(true)
  pushPlans                  Boolean @default(true)
  pushPlanReminders          Boolean @default(true)
  pushMoments                Boolean @default(true)
  pushLive                   Boolean @default(true)
  pushPro                    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
}

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType @default(DIRECT)
  planId    String?

  participants ConversationParticipant[]
  messages     DirectMessage[]

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([updatedAt])
  @@index([planId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt     DateTime?
  mutedAt        DateTime?
  archivedAt     DateTime?

  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model DirectMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String?
  mediaUrl       String?
  mediaPath      String?
  mediaName      String?
  mediaMimeType  String?
  mediaSize      Int?

  type           DirectMessageType @default(TEXT)
  momentId       String?
  metadata       String?          // JSON stringifié

  status         MessageStatus @default(SENT)
  isDeleted      Boolean       @default(false)

  reactions      DirectMessageReaction[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([momentId])
}

model DirectMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model City {
  id          String   @id @default(cuid())
  name        String
  country     String
  countryCode String
  currency    String
  timezone    String
  language    String   @default("fr")
  latitude    Float
  longitude   Float
  isActive    Boolean  @default(true)

  homeUsers   User[]   @relation("UserHomeCity")
  activeUsers User[]   @relation("UserActiveCity")
  places      Place[]
  plans       Plan[]
  visitedBy   UserVisitedCity[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, country])
}

model Place {
  id              String        @id @default(cuid())
  name            String
  description     String?
  category        PlaceCategory
  cityId          String
  city            City          @relation(fields: [cityId], references: [id])
  neighborhood    String?
  address         String?
  latitude        Float?
  longitude       Float?
  priceLevel      BudgetLevel?
  openingHours    String?
  images          String[]
  isPartner       Boolean       @default(false)
  isVisible       Boolean       @default(true)
  safetyLevel     SafetyLevel   @default(MEDIUM)
  popularityScore Int           @default(0)

  plans           Plan[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([cityId])
  @@index([category])
  @@index([isVisible])
}

model Plan {
  id                String          @id @default(cuid())
  title             String
  description       String?
  planCategory      PlanCategory    @default(AUTRE)
  mood              Mood
  budgetLevel       BudgetLevel     @default(MEDIUM)
  budgetAmount      Decimal?
  budgetCurrency    String?
  budgetIsFrom      Boolean         @default(false)
  estimatedCost     Float?
  cityId            String
  city              City            @relation(fields: [cityId], references: [id])
  countryCode       String?
  placeId           String?
  place             Place?          @relation(fields: [placeId], references: [id])
  neighborhood      String?
  latitude          Float?
  longitude         Float?
  startDate         DateTime
  endDate           DateTime?
  maxParticipants   Int             @default(10)
  visibility        PlanVisibility  @default(PUBLIC)
  status            PlanStatus      @default(ACTIVE)
  isTravelerFriendly Boolean        @default(false)
  safetyLevel       SafetyLevel     @default(MEDIUM)
  rules             String?
  isDemo            Boolean         @default(false)

  isCommunityConfirmed Boolean        @default(false)
  confirmationScore    Float          @default(0)

  isExpress          Boolean         @default(false)
  expiresAt          DateTime?

  creatorId         String
  creator           User            @relation(fields: [creatorId], references: [id])
  participants      PlanParticipant[]
  messages          PlanMessage[]
  invitations       PlanInvitation[]
  reports           Report[]
  savedPlans        SavedPlan[]
  reminders         PlanReminder[]
  reviews           PlanParticipantReview[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([cityId])
  @@index([creatorId])
  @@index([status])
  @@index([visibility])
  @@index([mood])
  @@index([planCategory])
  @@index([startDate])
  @@index([createdAt])
}

model PlanInvitation {
  id         String               @id @default(cuid())
  planId     String
  plan       Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User                 @relation("PlanInvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User                 @relation("PlanInvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     PlanInvitationStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([planId, receiverId])
  @@index([receiverId, status])
  @@index([planId])
}

model SavedPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
}

model PlanParticipant {
  id        String            @id @default(cuid())
  planId    String
  plan      Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ParticipantStatus   @default(PENDING)
  attendance  PlanAttendanceStatus @default(GOING)
  joinedAt    DateTime            @default(now())

  @@unique([planId, userId])
  @@index([planId])
  @@index([userId])
}

model PlanParticipantReview {
  id             String           @id @default(cuid())

  planId         String
  plan           Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User             @relation("PlanReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUserId String?
  reviewedUser   User?            @relation("PlanReviewReviewed", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  wasPresent     Boolean?
  wasRespectful  Boolean?
  profileSeemedReal Boolean?
  planWasReal    Boolean?
  comment        String?

  status         PlanReviewStatus @default(SUBMITTED)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([planId])
  @@index([reviewerId])
  @@index([reviewedUserId])
  @@unique([planId, reviewerId, reviewedUserId])
}

model PlanReminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  remindAt  DateTime
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([planId])
  @@index([remindAt])
  @@index([sentAt])
}

model PlanMessage {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([planId, createdAt])
  @@index([authorId])
}

model Moment {
  id          String           @id @default(cuid())
  authorId    String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type        MomentType
  mediaUrl    String
  caption     String?
  city        String?
  countryCode String?
  visibility  MomentVisibility @default(PUBLIC)
  isDemo      Boolean          @default(false)

  planId      String?
  placeId     String?
  eventId     String?
  liveId      String?

  audioTrackId String?
  audioStartTime Int?           @default(0)
  audioVolume Float?             @default(1)
  audioTrack   AudioTrack?       @relation(fields: [audioTrackId], references: [id], onDelete: SetNull)

  // Media editing metadata
  mediaWidth      Int?
  mediaHeight     Int?
  mediaDuration   Int?
  mediaCrop       Json?
  videoStartTime  Int?
  videoEndTime    Int?
  mediaAspectRatio String?

  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  likes       MomentLike[]
  comments    MomentComment[]

  @@index([city, createdAt])
  @@index([authorId])
  @@index([planId])
  @@index([placeId])
  @@index([createdAt])
  @@index([visibility])
}

model AudioTrack {
  id          String           @id @default(cuid())
  ownerId     String?
  owner       User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title       String
  artistName  String?
  sourceType  AudioSourceType  @default(USER_ORIGINAL)
  status      AudioStatus      @default(ACTIVE)

  audioUrl    String
  audioPath   String?
  duration    Int?
  coverUrl    String?

  isOfficial      Boolean          @default(false)
  isOriginal      Boolean          @default(false)
  usageCount      Int              @default(0)
  rightsConfirmed Boolean          @default(false)
  rightsNote      String?
  reportCount     Int              @default(0)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  moments         Moment[]

  @@index([ownerId])
  @@index([status])
  @@index([sourceType])
  @@index([usageCount])
}

model MomentEvent {
  id          String          @id @default(cuid())
  momentId    String
  userId      String?
  type        MomentEventType

  watchMs     Int?
  percent     Float?
  source      String?
  city        String?
  countryCode String?

  createdAt   DateTime        @default(now())

  @@index([momentId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model MomentScore {
  id        String   @id @default(cuid())
  momentId  String   @unique

  score         Float   @default(0)
  viralScore    Float   @default(0)
  localScore    Float   @default(0)
  qualityScore  Float   @default(0)
  safetyScore   Float   @default(1)

  impressions      Int @default(0)
  views            Int @default(0)
  completions      Int @default(0)
  replays          Int @default(0)
  likes            Int @default(0)
  comments         Int @default(0)
  shares           Int @default(0)
  dmShares         Int @default(0)
  saves            Int @default(0)
  reports          Int @default(0)
  profileOpens     Int @default(0)
  followsGenerated Int @default(0)
  notInterested    Int @default(0)
  seeMoreLikeThis  Int @default(0)

  avgWatchMs       Int @default(0)
  replayRate       Float @default(0)
  quickSkipRate    Float @default(0)

  audienceLevel    Int @default(0)
  lastCalculatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([score])
  @@index([viralScore])
  @@index([localScore])
  @@index([audienceLevel])
  @@index([updatedAt])
}

model UserQualityScore {
  id        String @id @default(cuid())
  userId    String @unique

  score         Float @default(50)
  trust         Float @default(0)
  activity      Float @default(0)
  reportsPenalty Float @default(0)
  creatorBoost   Float @default(0)

  lastCalculatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserTrustProfile {
  id        String @id @default(cuid())
  userId    String @unique

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  outsideScore      Float @default(0)
  presenceScore     Float @default(0)
  respectScore      Float @default(0)
  realProfileScore  Float @default(0)
  organizerScore    Float @default(0)

  plansJoined        Int @default(0)
  plansCreated       Int @default(0)
  validatedAttendances Int @default(0)
  positiveReviews    Int @default(0)
  reportsCount       Int @default(0)

  level String @default("Nouveau")

  lastCalculatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MomentLike {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

