generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  PRO
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  BLOCKED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FOLLOW
  PLAN_INVITE
  LIVE_STARTED
  PRO_EVENT
  PRO_APPROVED
  BADGE_EARNED
  SYSTEM
}

enum AvailabilityMood {
  FOOD
  CHILL
  SPORT
  MUSIC
  OUT
  STUDY
  BUSINESS
  TRAVEL
}

enum BudgetLevel {
  FREE
  LOW
  MEDIUM
  PREMIUM
}

enum Mood {
  CHILL
  FOOD
  SPORT
  PARTY
  MUSIC
  DATING
  FRIENDS
  STUDY
  BUSINESS
  CULTURE
  TRAVEL
  GAMING
  FITNESS
}

enum PlanVisibility {
  PUBLIC
  FRIENDS
  FRIENDS_OF_FRIENDS
  INVITE_ONLY
  PRIVATE
}

enum PlanStatus {
  ACTIVE
  FULL
  CANCELLED
  COMPLETED
}

enum PlanInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum MomentType {
  PHOTO
  VIDEO
}

enum MomentVisibility {
  PUBLIC
  FRIENDS
  PLAN_PARTICIPANTS
  PRIVATE
}

enum ConversationType {
  DIRECT
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  DELETED
}

enum DirectMessagePermission {
  FRIENDS_ONLY
  FRIENDS_AND_FOLLOWING
  EVERYONE
}

enum PlaceCategory {
  RESTAURANT
  CAFE
  LOUNGE
  MAQUIS
  BEACH
  GYM
  CINEMA
  CULTURE
  SPORT
  EVENT
  SHOP
  OTHER
}

enum SafetyLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  PENDING
  OPEN
  REVIEWING
  REVIEWED
  RESOLVED
  REJECTED
  DISMISSED
}

enum ReportReason {
  INAPPROPRIATE_CONTENT
  HARASSMENT
  SPAM
  FAKE_PROFILE
  DANGEROUS_PLAN
  UNDERAGE
  OTHER
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  REPORTED
  BLOCKED
}

enum LiveVisibility {
  PUBLIC
  CITY
  PLAN_PARTICIPANTS
  EVENT_ATTENDEES
  PRIVATE
}

enum ProAccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ENDED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum IdentityVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum TrustSignalType {
  PROFILE_PHOTO
  EMAIL_VERIFIED
  PHONE_VERIFIED
  IDENTITY_VERIFIED
  PLAN_ATTENDANCE
  RESPECTFUL
  REAL_PROFILE
  REAL_PLAN
}

model User {
  id                String   @id @default(cuid())
  name              String?
  username          String?  @unique
  email             String   @unique
  password          String?
  emailVerified     DateTime?
  phone             String?  @unique
  phoneVerified     DateTime?
  image             String?
  bio               String?
  gender            Gender?
  role              UserRole @default(USER)
  isDemoAccount     Boolean  @default(false)

  birthDate         DateTime?
  isAdultConfirmed  Boolean  @default(false)
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?

  homeCityId        String?
  homeCity          City?    @relation("UserHomeCity", fields: [homeCityId], references: [id])
  activeCityId      String?
  activeCity        City?    @relation("UserActiveCity", fields: [activeCityId], references: [id])
  neighborhood      String?
  language          String   @default("fr")
  preferredBudget   BudgetLevel?
  preferredMoods    Mood[]

  country           String?
  countryCode       String?

  isVerified        Boolean  @default(false)
  trustScore        Int      @default(0)
  identityVerificationStatus IdentityVerificationStatus @default(NOT_SUBMITTED)
  isAvailable       Boolean  @default(false)
  travelModeEnabled Boolean  @default(false)

  plansCreated      Plan[]
  planParticipants  PlanParticipant[]
  planMessages      PlanMessage[]
  planInvitationsSent    PlanInvitation[] @relation("PlanInvitationSender")
  planInvitationsReceived PlanInvitation[] @relation("PlanInvitationReceiver")
  moments            Moment[]
  userBadges         UserBadge[]
  reportsMade       Report[] @relation("Reporter")
  reportsReceived   Report[] @relation("Reported")
  blocksMade        UserBlock[] @relation("Blocker")
  blocksReceived    UserBlock[] @relation("Blocked")
  visitedCities     UserVisitedCity[]
  friendshipsInitiated Friendship[] @relation("FriendshipInitiator")
  friendshipsReceived  Friendship[] @relation("FriendshipReceiver")

  friendRequestsSent     FriendRequest[] @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestReceiver")

  followers  Follow[] @relation("UserFollowers")
  following  Follow[] @relation("UserFollowing")

  notifications     Notification[] @relation("NotificationRecipient")
  trustReviewsGiven    TrustReview[] @relation("TrustReviewReviewer")
  trustReviewsReceived TrustReview[] @relation("TrustReviewReviewed")
  availabilities       Availability[]

  liveSessions      LiveSession[]
  proAccount        ProAccount?
  identityVerification IdentityVerification?
  trustSignals      TrustSignal[]
  userSettings      UserSettings?
  momentLikes       MomentLike[]
  momentComments    MomentComment[]
  conversationParticipants ConversationParticipant[]
  directMessagesSent       DirectMessage[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([homeCityId])
  @@index([activeCityId])
  @@index([isAvailable])
}

model UserSettings {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileVisibility        String  @default("PUBLIC")
  showCityOnProfile        Boolean @default(true)
  allowFriendRequests      Boolean @default(true)
  directMessagePermission  DirectMessagePermission @default(FRIENDS_ONLY)
  allowFollowers           Boolean @default(true)
  allowFriendSuggestions   Boolean @default(true)

  notificationFriendRequests Boolean @default(true)
  notificationPlanInvites    Boolean @default(true)
  notificationCityLives      Boolean @default(true)
  notificationProEvents      Boolean @default(true)
  notificationMoments        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType @default(DIRECT)

  participants ConversationParticipant[]
  messages     DirectMessage[]

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt     DateTime?
  mutedAt        DateTime?
  archivedAt     DateTime?

  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model DirectMessage {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String?
  mediaUrl       String?

  status         MessageStatus @default(SENT)
  isDeleted      Boolean       @default(false)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model City {
  id          String   @id @default(cuid())
  name        String
  country     String
  countryCode String
  currency    String
  timezone    String
  language    String   @default("fr")
  latitude    Float
  longitude   Float
  isActive    Boolean  @default(true)

  homeUsers   User[]   @relation("UserHomeCity")
  activeUsers User[]   @relation("UserActiveCity")
  places      Place[]
  plans       Plan[]
  visitedBy   UserVisitedCity[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, country])
}

model Place {
  id              String        @id @default(cuid())
  name            String
  description     String?
  category        PlaceCategory
  cityId          String
  city            City          @relation(fields: [cityId], references: [id])
  neighborhood    String?
  address         String?
  latitude        Float?
  longitude       Float?
  priceLevel      BudgetLevel?
  openingHours    String?
  images          String[]
  isPartner       Boolean       @default(false)
  isVisible       Boolean       @default(true)
  safetyLevel     SafetyLevel   @default(MEDIUM)
  popularityScore Int           @default(0)

  plans           Plan[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([cityId])
  @@index([category])
  @@index([isVisible])
}

model Plan {
  id                String          @id @default(cuid())
  title             String
  description       String?
  category          PlaceCategory
  mood              Mood
  budgetLevel       BudgetLevel
  estimatedCost     Float?
  cityId            String
  city              City            @relation(fields: [cityId], references: [id])
  placeId           String?
  place             Place?          @relation(fields: [placeId], references: [id])
  neighborhood      String?
  latitude          Float?
  longitude         Float?
  startDate         DateTime
  endDate           DateTime?
  maxParticipants   Int             @default(10)
  visibility        PlanVisibility  @default(PUBLIC)
  status            PlanStatus      @default(ACTIVE)
  isTravelerFriendly Boolean        @default(false)
  safetyLevel       SafetyLevel     @default(MEDIUM)
  rules             String?
  isDemo            Boolean         @default(false)

  creatorId         String
  creator           User            @relation(fields: [creatorId], references: [id])
  participants      PlanParticipant[]
  messages          PlanMessage[]
  invitations       PlanInvitation[]
  reports           Report[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([cityId])
  @@index([creatorId])
  @@index([status])
  @@index([visibility])
  @@index([mood])
  @@index([startDate])
}

model PlanInvitation {
  id         String               @id @default(cuid())
  planId     String
  plan       Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User                 @relation("PlanInvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User                 @relation("PlanInvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     PlanInvitationStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([planId, receiverId])
  @@index([receiverId, status])
  @@index([planId])
}

model PlanParticipant {
  id        String            @id @default(cuid())
  planId    String
  plan      Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ParticipantStatus @default(PENDING)
  joinedAt  DateTime          @default(now())

  @@unique([planId, userId])
  @@index([planId])
  @@index([userId])
}

model PlanMessage {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([planId, createdAt])
  @@index([authorId])
}

model Moment {
  id          String           @id @default(cuid())
  authorId    String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type        MomentType
  mediaUrl    String
  caption     String?
  city        String?
  countryCode String?
  visibility  MomentVisibility @default(PUBLIC)
  isDemo      Boolean          @default(false)

  planId      String?
  placeId     String?
  eventId     String?
  liveId      String?

  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  likes       MomentLike[]
  comments    MomentComment[]

  @@index([city, createdAt])
  @@index([authorId])
  @@index([planId])
  @@index([placeId])
}

model MomentLike {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([momentId, userId])
  @@index([momentId])
  @@index([userId])
}

model MomentComment {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  isDeleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([momentId, createdAt])
  @@index([userId])
}

model Badge {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String
  icon        String?
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model Report {
  id              String       @id @default(cuid())
  reporterId      String
  reporter        User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId  String?
  reportedUser    User?        @relation("Reported", fields: [reportedUserId], references: [id])
  planId          String?
  plan            Plan?        @relation(fields: [planId], references: [id])
  placeId         String?
  targetType      String?
  targetId        String?
  reason          ReportReason
  description     String?
  status          ReportStatus @default(PENDING)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([reporterId])
  @@index([status])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model UserVisitedCity {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId        String
  city          City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  firstVisitedAt DateTime @default(now())
  lastVisitedAt  DateTime @updatedAt

  @@unique([userId, cityId])
}

model Friendship {
  id          String   @id @default(cuid())
  initiatorId String
  initiator   User     @relation("FriendshipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([initiatorId, receiverId])
  @@index([initiatorId])
  @@index([receiverId])
}

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String

  sender     User                @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  status     FriendRequestStatus @default(PENDING)

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Follow {
  id          String   @id @default(cuid())

  followerId  String
  followingId String

  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  body        String?
  data        String?          // JSON stringifié pour metadata

  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId     String?
  actorName   String?
  actorImage  String?

  isRead      Boolean          @default(false)
  readAt      DateTime?

  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead])
  @@index([createdAt])
}

model TrustReview {
  id          String   @id @default(cuid())
  reviewerId  String
  reviewedId  String
  planId      String?

  wasPresent  Boolean?
  respectful  Boolean?
  realProfile Boolean?
  realPlan    Boolean?
  goodVibe    Boolean?
  comment     String?

  createdAt   DateTime @default(now())

  reviewer    User     @relation("TrustReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewed    User     @relation("TrustReviewReviewed", fields: [reviewedId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, reviewedId, planId])
  @@index([reviewedId])
}

model IdentityVerification {
  id          String                     @id @default(cuid())
  userId      String                     @unique
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      IdentityVerificationStatus @default(PENDING)
  fullName    String?
  documentType String?
  documentPath String?
  selfiePath   String?

  reviewedById String?
  reviewedAt   DateTime?
  rejectionReason String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TrustSignal {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              TrustSignalType
  label             String
  value             Boolean         @default(true)
  validatedByUserId String?
  source            String?
  createdAt         DateTime        @default(now())

  @@index([userId])
  @@index([type])
}

model Availability {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  mood        AvailabilityMood
  city        String?
  country     String?
  countryCode String?

  isActive    Boolean          @default(true)
  expiresAt   DateTime

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([city, isActive])
  @@index([userId, isActive])
}

model LiveSession {
  id             String         @id @default(cuid())
  title          String
  description    String?
  status         LiveStatus     @default(SCHEDULED)
  visibility     LiveVisibility @default(CITY)

  city           String?
  country        String?
  countryCode    String?

  hostId         String
  host           User           @relation(fields: [hostId], references: [id], onDelete: Cascade)

  planId         String?
  eventId        String?
  placeId        String?

  thumbnailUrl    String?
  streamProvider  String?
  streamKey       String?
  playbackUrl     String?
  livekitRoomName String?

  viewerCount    Int            @default(0)
  startedAt      DateTime?
  endedAt        DateTime?
  isDemo         Boolean        @default(false)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([hostId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
}

model ProAccount {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName    String
  businessType    String?
  description     String?
  country         String?
  countryCode     String?
  city            String?
  addressLabel    String?
  phone           String?
  email           String?
  website         String?
  logoUrl         String?

  status          ProAccountStatus  @default(PENDING)
  verifiedAt      DateTime?
  rejectedReason  String?

  events          ProEvent[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([city])
}

model ProEvent {
  id              String          @id @default(cuid())
  proAccountId    String
  proAccount      ProAccount      @relation(fields: [proAccountId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  category        String?
  coverImageUrl   String?
  city            String?
  country         String?
  countryCode     String?
  venueName       String?
  addressLabel    String?

  startsAt        DateTime
  endsAt          DateTime?
  priceLabel      String?
  currency        String?
  ticketUrl       String?
  reservationUrl  String?

  status          EventStatus     @default(DRAFT)
  visibility      EventVisibility @default(PUBLIC)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([proAccountId])
  @@index([status])
  @@index([city])
  @@index([startsAt])
}
